# Server Configuration
NODE_ENV=development
PORT=3003

# System Identifier
SYSTEM_NAME=SPD

# Database
DATABASE_URL=postgresql://postgres:123456@localhost:5432/core_spd_db

# JWT Configuration (PEM with \n escaped)
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----
"

# For local testing with Azure Service Bus Emulator:
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator:5672;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true
SERVICEBUS_TOPIC=spd.events
SERVICEBUS_SUBSCRIPTION=spd-worker
SERVICEBUS_SUBJECT_PREFIX=SpdCore.

# SAP Configuration
SAP_URL="http://server:port/..."
SAP_AUTH="Basic ..."
