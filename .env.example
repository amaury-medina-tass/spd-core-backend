# Server Configuration
NODE_ENV=development
PORT=3003

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/core_spd_db

# JWT Configuration (PEM with \n escaped)
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...\n-----END PUBLIC KEY-----"

# Service Bus (Optional for local development)
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
SERVICEBUS_TOPIC=spd.events
SERVICEBUS_SUBJECT_PREFIX=SpdCore.

# SAP Configuration
SAP_URL="http://spodev.medellin.gov.co:50000/XISOAPAdapter/MessageServlet?senderParty=&senderService=BC_SICGEM&receiverParty=&receiverService=&interface=SI_Contratos_Out&interfaceNamespace=urn%3A%2F%2Fmedellin.gov.co%3ASICGEM%3AConsultaContratos"
SAP_AUTH="Basic {TOKEN}"
