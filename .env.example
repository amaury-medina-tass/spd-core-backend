# Server Configuration
NODE_ENV=development
PORT=3003

# System Identifier
SYSTEM_NAME=SPD

# Database
DATABASE_URL=postgresql://postgres:123456@localhost:5432/core_spd_db

# JWT Configuration (PEM with \n escaped)
JWT_ACCESS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----
"

# For local testing with Azure Service Bus Emulator:
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator:5672;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true
SERVICEBUS_TOPIC=spd.events
SERVICEBUS_SUBSCRIPTION=spd-worker
SERVICEBUS_SUBJECT_PREFIX=SpdCore.

# SAP Configuration
SAP_URL="http://server:port/..."
SAP_AUTH="Basic ..."

# Cosmos DB (Audit Logs)
# BD compartida: spd_audit | Container por microservicio: auth_logs, spd_core_logs, etc.
# Usar host.docker.internal para acceder al emulador desde Docker
COSMOS_DB_ENDPOINT=https://host.docker.internal:8081
COSMOS_DB_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
COSMOS_DB_DATABASE=spd_audit
COSMOS_DB_CONTAINER=spd_core_logs
COSMOS_DB_DISABLE_SSL=true
